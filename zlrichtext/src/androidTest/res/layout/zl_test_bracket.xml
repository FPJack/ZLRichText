    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.zl.richtext.ZLBracketTextView
        android:id="@+id/zl_test_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[h1]a[/h1]&lt;h1>b&lt;/h1>" />

    <com.zl.richtext.ZLBracketTextView
