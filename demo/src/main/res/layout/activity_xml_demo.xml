<?xml version="1.0" encoding="utf-8"?>
<!-- Every view below is configured with XML attributes only (rules and tag styles are added in code). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/xml_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF3EDF7"
            android:padding="10dp"
            android:text="点击链接 / 标签，或展开文字，这里显示回调"
            android:textColor="#FF000000"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            style="@style/DemoSectionTitle"
            android:text="1. ZLAttributedTextView：识别 / 链接颜色 / 截断符" />

        <com.zl.richtext.ZLAttributedTextView
            android:id="@+id/xml_attributed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@string/xml_attributed_text"
            android:textColor="#DE000000"
            android:textSize="15sp"
            app:zl_activeLinkBackgroundColor="#33009688"
            app:zl_dataDetectorTypes="link|phoneNumber"
            app:zl_linkColor="#FF009688"
            app:zl_truncationToken="…更多"
            app:zl_truncationTokenColor="#FF2196F3" />

        <TextView
            style="@style/DemoSectionTitle"
            android:text="2. ZLAttributedTextView：单行中间截断 + 字号自适应" />

        <com.zl.richtext.ZLAttributedTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF3EDF7"
            android:maxLines="1"
            android:padding="8dp"
            android:text="Very long single line title: shrinks first (minimumScaleFactor 0.7), then truncates in the middle"
            android:textSize="18sp"
            android:textStyle="bold"
            app:zl_adjustsFontSizeToFit="true"
            app:zl_minimumScaleFactor="0.7"
            app:zl_truncationMode="middle" />

        <TextView
            style="@style/DemoSectionTitle"
            android:text="3. ZLRichTextView：展开 / 收起 / 按下高亮" />

        <com.zl.richtext.ZLRichTextView
            android:id="@+id/xml_rich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:maxLines="3"
            android:text="@string/xml_rich_text"
            android:textColor="#DE000000"
            android:textSize="15sp"
            app:zl_collapseToken=" 收起"
            app:zl_expandToken="… 全文"
            app:zl_expandTokenColor="#FFFF5722"
            app:zl_highlightBackgroundColor="#33FF9800" />

        <TextView
            style="@style/DemoSectionTitle"
            android:text="4. ZLTagTextView：标签样式与解析配置" />

        <com.zl.richtext.ZLTagTextView
            android:id="@+id/xml_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xml_tag_text"
            android:textColor="#DE000000"
            android:textSize="15sp"
            app:zl_highlightBackgroundColor="#1F000000"
            app:zl_tagBold="true"
            app:zl_tagColor="#FF2196F3"
            app:zl_tagUnderline="true" />

        <com.zl.richtext.ZLTagTextView
            android:id="@+id/xml_any_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/xml_any_tags_text"
            android:textColor="#DE000000"
            android:textSize="15sp"
            app:zl_anyTags="true" />

        <com.zl.richtext.ZLTagTextView
            android:id="@+id/xml_delimiter_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/xml_delimiter_text"
            android:textColor="#DE000000"
            android:textSize="15sp"
            app:zl_tagCloseDelimiter="】"
            app:zl_tagColor="#FF2196F3"
            app:zl_tagOpenDelimiter="【"
            app:zl_tagUnderline="true" />

        <com.zl.richtext.ZLBracketTextView
            android:id="@+id/xml_bracket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/xml_bracket_text"
            android:textColor="#DE000000"
            android:textSize="15sp"
            app:zl_highlightBackgroundColor="#1F000000"
            app:zl_tagColor="#FFFF5722"
            app:zl_tagUnderline="true" />

        <TextView
            style="@style/DemoSectionTitle"
            android:text="5. 动态文字：输入时实时解析，高度跟着变化" />

        <com.zl.richtext.ZLTagTextView
            android:id="@+id/xml_dynamic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF2F2F7"
            android:padding="8dp"
            android:textColor="#DE000000"
            android:textSize="15sp"
            app:zl_tagColor="#FF9C27B0"
            app:zl_tagUnderline="true" />

        <EditText
            android:id="@+id/xml_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入带 &lt;h1&gt;…&lt;/h1&gt; 的文字"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:text="输入文字，&lt;h1&gt;标签&lt;/h1&gt;会实时高亮，高度跟着内容变化。" />

        <TextView
            style="@style/DemoSectionTitle"
            android:text="6. 展开状态与外部开关双向同步" />

        <com.zl.richtext.ZLTagTextView
            android:id="@+id/xml_expand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="label 内部点击「全文」展开后，通过 onExpandChangeListener 同步到开关；拨动开关后，设置 isExpanded 同步回 label（不会触发回调，不会循环）。无论哪一边改变，高度都会自动重新计算。这里再多写一些文字，保证收起时一定会被截断。"
            android:textColor="#DE000000"
            android:textSize="15sp"
            app:zl_collapseToken=" 收起"
            app:zl_expandToken="… 全文"
            app:zl_expandTokenColor="#FFFF9800" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/xml_expand_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="isExpanded" />

        <TextView
            style="@style/DemoSectionTitle"
            android:text="7. maxLines 步进器（0 表示不限制）" />

        <com.zl.richtext.ZLTagTextView
            android:id="@+id/xml_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="maxLines 与 SwiftUI 的 .lineLimit(_:) 一样限制行数。&lt;h1&gt;这段文字比较长&lt;/h1&gt;，用下面的按钮调整显示的行数，0 表示不限制。超出的部分显示省略号，高度跟着行数变化。"
            android:textColor="#DE000000"
            android:textSize="15sp"
            app:zl_tagColor="#FF009688" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/xml_lines_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="maxLines = 2" />

            <Button
                android:id="@+id/xml_lines_minus"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="−" />

            <Button
                android:id="@+id/xml_lines_plus"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="+" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
